--- !u!114 &8708905923355123207
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1207665736112914597}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 33c5ab89f42276542b83100487da16ca, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NonPlayerCharacter
  dialogueLines:
  - '"I was afraid you wouldn''t make it in time."'
  - '"Something went wrong in the laboratories."'
  - '"There was a chemical leak..."'
  - '"And whatever was released into the city changed the boilers."'
  - '"They were harmless before."'
  - '"Now they''re moving on their own."'
  - '"They''re overheating, exploding, and attacking anything around them."'
  - '"Don''t destroy them."'
  - '"They''re not supposed to be dangerous."'
  - '"You need to bring them back under control."'
  - '"Look around the laboratories. You should find the equipment you need."'
  - '"Use it on the boilers when you find one that''s gone out of control."'
  - '"And if you get hurt..."'
  - '"These kiwis should help."'
  - '"I don''t know why kiwis work...just don''t ask questions."'
  - '"So watch your step."'
  - '"And please..."'
  - '"Be careful around the chemicals."'
  - '"We don''t know how much of the city has been affected."'
  - '"Some of the laboratories haven''t been checked yet."'
  - '"So don''t go too far without watching your step."'
  - '"Good luck."'
  greetingLine: Oh... You're finally here.
