--- !u!114 &-1076214742585840146
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 29287724312542000}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 33c5ab89f42276542b83100487da16ca, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NonPlayerCharacter
  dialogueLines:
  - '"Oh... You''re finally here."'
  - '"I was starting to think you weren''t coming."'
  - '"Something went wrong in the city."'
  - '"The robots... they''re not acting like themselves anymore."'
  - '"They were built to protect this place."'
  - '"But now they''re attacking anything that gets too close."'
  - '"Don''t destroy them."'
  - '"You need to fix them."'
  - '"You''ll need repair parts to bring them back to normal."'
  - '"Look around the city. You should find what you need."'
  - '"When you find a broken robot, use the parts on it."'
  - '"Strawberries will patch you up if you get hurt."'
  - '"They''re not exactly medicine...but they work."'
  - '"And one more thing..."'
  - '"Don''t assume the city is safe just because the robots are broken."'
  - '"We don''t know how far the malfunction has spread."'
  - '"So watch your step."'
  - '"Good luck."'
