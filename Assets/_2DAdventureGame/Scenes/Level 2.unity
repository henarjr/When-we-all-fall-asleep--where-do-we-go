      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 1604327725964152957, guid: ec7ee1e8a1347544da7d8b2c5c855c4d,
        type: 3}
      propertyPath: m_LocalEulerAnglesHint.z
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3329044014023449430, guid: ec7ee1e8a1347544da7d8b2c5c855c4d,
        type: 3}
      propertyPath: m_Name
      value: NPC2
      objectReference: {fileID: 0}
    - target: {fileID: 8624818985732712531, guid: ec7ee1e8a1347544da7d8b2c5c855c4d,
        type: 3}
      propertyPath: dialogueLines.Array.size
      value: 22
      objectReference: {fileID: 0}
    - target: {fileID: 8624818985732712531, guid: ec7ee1e8a1347544da7d8b2c5c855c4d,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[0]'
      value: '"I was afraid you wouldn''t make it in time."'
      objectReference: {fileID: 0}
    - target: {fileID: 8624818985732712531, guid: ec7ee1e8a1347544da7d8b2c5c855c4d,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[1]'
      value: '"Something went wrong in the laboratories."'
      objectReference: {fileID: 0}
    - target: {fileID: 8624818985732712531, guid: ec7ee1e8a1347544da7d8b2c5c855c4d,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[2]'
      value: '"There was a chemical leak..."'
      objectReference: {fileID: 0}
    - target: {fileID: 8624818985732712531, guid: ec7ee1e8a1347544da7d8b2c5c855c4d,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[3]'
      value: '"And whatever was released into the city changed the boilers."'
      objectReference: {fileID: 0}
    - target: {fileID: 8624818985732712531, guid: ec7ee1e8a1347544da7d8b2c5c855c4d,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[4]'
      value: '"They were harmless before."'
      objectReference: {fileID: 0}
    - target: {fileID: 8624818985732712531, guid: ec7ee1e8a1347544da7d8b2c5c855c4d,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[5]'
      value: '"Now they''re moving on their own."'
      objectReference: {fileID: 0}
    - target: {fileID: 8624818985732712531, guid: ec7ee1e8a1347544da7d8b2c5c855c4d,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[6]'
      value: '"They''re overheating, exploding, and attacking anything around them."'
      objectReference: {fileID: 0}
    - target: {fileID: 8624818985732712531, guid: ec7ee1e8a1347544da7d8b2c5c855c4d,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[7]'
      value: '"Don''t destroy them."'
      objectReference: {fileID: 0}
    - target: {fileID: 8624818985732712531, guid: ec7ee1e8a1347544da7d8b2c5c855c4d,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[8]'
      value: '"They''re not supposed to be dangerous."'
      objectReference: {fileID: 0}
    - target: {fileID: 8624818985732712531, guid: ec7ee1e8a1347544da7d8b2c5c855c4d,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[9]'
      value: '"You need to bring them back under control."'
      objectReference: {fileID: 0}
    - target: {fileID: 8624818985732712531, guid: ec7ee1e8a1347544da7d8b2c5c855c4d,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[10]'
      value: '"Look around the laboratories. You should find the equipment you need."'
      objectReference: {fileID: 0}
    - target: {fileID: 8624818985732712531, guid: ec7ee1e8a1347544da7d8b2c5c855c4d,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[11]'
      value: '"Use it on the boilers when you find one that''s gone out of control."'
      objectReference: {fileID: 0}
    - target: {fileID: 8624818985732712531, guid: ec7ee1e8a1347544da7d8b2c5c855c4d,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[12]'
      value: '"And if you get hurt..."'
      objectReference: {fileID: 0}
    - target: {fileID: 8624818985732712531, guid: ec7ee1e8a1347544da7d8b2c5c855c4d,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[13]'
      value: '"These kiwis should help."'
      objectReference: {fileID: 0}
    - target: {fileID: 8624818985732712531, guid: ec7ee1e8a1347544da7d8b2c5c855c4d,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[14]'
      value: '"I don''t know why kiwis work...just don''t ask questions."'
      objectReference: {fileID: 0}
    - target: {fileID: 8624818985732712531, guid: ec7ee1e8a1347544da7d8b2c5c855c4d,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[16]'
      value: '"And please..."'
      objectReference: {fileID: 0}
    - target: {fileID: 8624818985732712531, guid: ec7ee1e8a1347544da7d8b2c5c855c4d,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[17]'
      value: '"Be careful around the chemicals."'
      objectReference: {fileID: 0}
    - target: {fileID: 8624818985732712531, guid: ec7ee1e8a1347544da7d8b2c5c855c4d,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[18]'
      value: '"We don''t know how much of the city has been affected."'
      objectReference: {fileID: 0}
    - target: {fileID: 8624818985732712531, guid: ec7ee1e8a1347544da7d8b2c5c855c4d,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[19]'
      value: '"Some of the laboratories haven''t been checked yet."'
      objectReference: {fileID: 0}
    - target: {fileID: 8624818985732712531, guid: ec7ee1e8a1347544da7d8b2c5c855c4d,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[20]'
      value: '"So don''t go too far without watching your step."'
      objectReference: {fileID: 0}
    - target: {fileID: 8624818985732712531, guid: ec7ee1e8a1347544da7d8b2c5c855c4d,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[21]'
      value: '"Good luck."'
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: ec7ee1e8a1347544da7d8b2c5c855c4d, type: 3}
