        type: 3}
      propertyPath: m_LocalEulerAnglesHint.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 5650125690811080160, guid: 63ba17a652acd5146ae7f00fd753d812,
        type: 3}
      propertyPath: m_LocalEulerAnglesHint.z
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 8708905923355123207, guid: 63ba17a652acd5146ae7f00fd753d812,
        type: 3}
      propertyPath: greetingLine
      value: '"Oh, thank goodness! You''re finally here!"'
      objectReference: {fileID: 0}
    - target: {fileID: 8708905923355123207, guid: 63ba17a652acd5146ae7f00fd753d812,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[0]'
      value: '"I was starting to think I''d have to deal with this mess myself."'
      objectReference: {fileID: 0}
    - target: {fileID: 8708905923355123207, guid: 63ba17a652acd5146ae7f00fd753d812,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[1]'
      value: '"Look around you... Sugar Land is a disaster!"'
      objectReference: {fileID: 0}
    - target: {fileID: 8708905923355123207, guid: 63ba17a652acd5146ae7f00fd753d812,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[2]'
      value: '"The vending machines have gone completely out of control."'
      objectReference: {fileID: 0}
    - target: {fileID: 8708905923355123207, guid: 63ba17a652acd5146ae7f00fd753d812,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[3]'
      value: '"They used to give everyone their favorite treats."'
      objectReference: {fileID: 0}
    - target: {fileID: 8708905923355123207, guid: 63ba17a652acd5146ae7f00fd753d812,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[4]'
      value: '"But something changed."'
      objectReference: {fileID: 0}
    - target: {fileID: 8708905923355123207, guid: 63ba17a652acd5146ae7f00fd753d812,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[5]'
      value: '"They started eating the candy instead of giving it away!"'
      objectReference: {fileID: 0}
    - target: {fileID: 8708905923355123207, guid: 63ba17a652acd5146ae7f00fd753d812,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[6]'
      value: '"And the more sugar they consumed..."'
      objectReference: {fileID: 0}
    - target: {fileID: 8708905923355123207, guid: 63ba17a652acd5146ae7f00fd753d812,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[7]'
      value: '"The crazier they became."'
      objectReference: {fileID: 0}
    - target: {fileID: 8708905923355123207, guid: 63ba17a652acd5146ae7f00fd753d812,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[8]'
      value: '"Now they''re running wild and attacking everyone in sight."'
      objectReference: {fileID: 0}
    - target: {fileID: 8708905923355123207, guid: 63ba17a652acd5146ae7f00fd753d812,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[9]'
      value: '"Please, don''t destroy them."'
      objectReference: {fileID: 0}
    - target: {fileID: 8708905923355123207, guid: 63ba17a652acd5146ae7f00fd753d812,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[10]'
      value: '"They''re just machines. They need to be fixed!"'
      objectReference: {fileID: 0}
    - target: {fileID: 8708905923355123207, guid: 63ba17a652acd5146ae7f00fd753d812,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[11]'
      value: '"You should be able to find repair parts scattered around the land."'
      objectReference: {fileID: 0}
    - target: {fileID: 8708905923355123207, guid: 63ba17a652acd5146ae7f00fd753d812,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[12]'
      value: '"Collect them and use them to fix the vending machines."'
      objectReference: {fileID: 0}
    - target: {fileID: 8708905923355123207, guid: 63ba17a652acd5146ae7f00fd753d812,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[13]'
      value: '"Oh, and one more thing!"'
      objectReference: {fileID: 0}
    - target: {fileID: 8708905923355123207, guid: 63ba17a652acd5146ae7f00fd753d812,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[14]'
      value: '"If you get hurt, look for cherries and sweets."'
      objectReference: {fileID: 0}
    - target: {fileID: 8708905923355123207, guid: 63ba17a652acd5146ae7f00fd753d812,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[15]'
      value: '"They''ll help you get back on your feet."'
      objectReference: {fileID: 0}
    - target: {fileID: 8708905923355123207, guid: 63ba17a652acd5146ae7f00fd753d812,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[16]'
      value: '"I know, I know... eating candy to feel better sounds ridiculous."'
      objectReference: {fileID: 0}
    - target: {fileID: 8708905923355123207, guid: 63ba17a652acd5146ae7f00fd753d812,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[17]'
      value: '"But hey, we''re in Sugar Land!"'
      objectReference: {fileID: 0}
    - target: {fileID: 8708905923355123207, guid: 63ba17a652acd5146ae7f00fd753d812,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[18]'
      value: '"Just be careful around those machines."'
      objectReference: {fileID: 0}
    - target: {fileID: 8708905923355123207, guid: 63ba17a652acd5146ae7f00fd753d812,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[19]'
      value: '"They may look harmless..."'
      objectReference: {fileID: 0}
    - target: {fileID: 8708905923355123207, guid: 63ba17a652acd5146ae7f00fd753d812,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[20]'
      value: '"But trust me, you don''t want to get on their bad side."'
      objectReference: {fileID: 0}
    - target: {fileID: 8708905923355123207, guid: 63ba17a652acd5146ae7f00fd753d812,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[21]'
      value: '"Now go on! We''ve got a whole city to save!"'
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 63ba17a652acd5146ae7f00fd753d812, type: 3}
