--- !u!1001 &8826377351832635931
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: -1076214742585840146, guid: 95ec60e92396d7944b72678915e6bc55,
        type: 3}
      propertyPath: dialogueLines.Array.size
      value: 17
      objectReference: {fileID: 0}
    - target: {fileID: -1076214742585840146, guid: 95ec60e92396d7944b72678915e6bc55,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[0]'
      value: '"I was starting to think you weren''t coming."'
      objectReference: {fileID: 0}
    - target: {fileID: -1076214742585840146, guid: 95ec60e92396d7944b72678915e6bc55,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[1]'
      value: '"Something went wrong in the city."'
      objectReference: {fileID: 0}
    - target: {fileID: -1076214742585840146, guid: 95ec60e92396d7944b72678915e6bc55,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[2]'
      value: '"The robots... they''re not acting like themselves anymore."'
      objectReference: {fileID: 0}
    - target: {fileID: -1076214742585840146, guid: 95ec60e92396d7944b72678915e6bc55,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[3]'
      value: '"They were built to protect this place."'
      objectReference: {fileID: 0}
    - target: {fileID: -1076214742585840146, guid: 95ec60e92396d7944b72678915e6bc55,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[4]'
      value: '"But now they''re attacking anything that gets too close."'
      objectReference: {fileID: 0}
    - target: {fileID: -1076214742585840146, guid: 95ec60e92396d7944b72678915e6bc55,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[5]'
      value: '"Don''t destroy them."'
      objectReference: {fileID: 0}
    - target: {fileID: -1076214742585840146, guid: 95ec60e92396d7944b72678915e6bc55,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[6]'
      value: '"You need to fix them."'
      objectReference: {fileID: 0}
    - target: {fileID: -1076214742585840146, guid: 95ec60e92396d7944b72678915e6bc55,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[7]'
      value: '"You''ll need repair parts to bring them back to normal."'
      objectReference: {fileID: 0}
    - target: {fileID: -1076214742585840146, guid: 95ec60e92396d7944b72678915e6bc55,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[8]'
      value: '"Look around the city. You should find what you need."'
      objectReference: {fileID: 0}
    - target: {fileID: -1076214742585840146, guid: 95ec60e92396d7944b72678915e6bc55,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[9]'
      value: '"When you find a broken robot, use the parts on it."'
      objectReference: {fileID: 0}
    - target: {fileID: -1076214742585840146, guid: 95ec60e92396d7944b72678915e6bc55,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[10]'
      value: '"Strawberries will patch you up if you get hurt."'
      objectReference: {fileID: 0}
    - target: {fileID: -1076214742585840146, guid: 95ec60e92396d7944b72678915e6bc55,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[11]'
      value: '"They''re not exactly medicine...but they work."'
      objectReference: {fileID: 0}
    - target: {fileID: -1076214742585840146, guid: 95ec60e92396d7944b72678915e6bc55,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[12]'
      value: '"And one more thing..."'
      objectReference: {fileID: 0}
    - target: {fileID: -1076214742585840146, guid: 95ec60e92396d7944b72678915e6bc55,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[13]'
      value: '"Don''t assume the city is safe just because the robots are broken."'
      objectReference: {fileID: 0}
    - target: {fileID: -1076214742585840146, guid: 95ec60e92396d7944b72678915e6bc55,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[14]'
      value: '"We don''t know how far the malfunction has spread."'
      objectReference: {fileID: 0}
    - target: {fileID: -1076214742585840146, guid: 95ec60e92396d7944b72678915e6bc55,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[15]'
      value: '"So watch your step."'
      objectReference: {fileID: 0}
    - target: {fileID: -1076214742585840146, guid: 95ec60e92396d7944b72678915e6bc55,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[16]'
      value: '"Good luck."'
      objectReference: {fileID: 0}
    - target: {fileID: -1076214742585840146, guid: 95ec60e92396d7944b72678915e6bc55,
        type: 3}
      propertyPath: 'dialogueLines.Array.data[17]'
      value: '"Oh... You''re finally here."'
      objectReference: {fileID: 0}
    - target: {fileID: 29287724312542000, guid: 95ec60e92396d7944b72678915e6bc55,
        type: 3}
      propertyPath: m_Name
      value: NPC
      objectReference: {fileID: 0}
    - target: {fileID: 725602515383864397, guid: 95ec60e92396d7944b72678915e6bc55,
        type: 3}
